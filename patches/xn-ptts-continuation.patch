+/// High-pass cutoff of [`condense_speech`], in Hz: below the voice, where room rumble and
+/// handling noise sit.
+pub const SPEECH_HIGHPASS_HZ: f32 = 80.0;
+/// Frames more than this many dB below the loud end of the recording count as silence.
+pub const SILENCE_BELOW_DB: f32 = 30.0;
+/// Audio kept on each side of speech when silence is cut, in seconds.
+pub const SPEECH_MARGIN_S: f32 = 0.15;
+
+/// Conditions a reference recording for the speaker encoder: high-passes it at
+/// [`SPEECH_HIGHPASS_HZ`] and cuts the pauses, keeping [`SPEECH_MARGIN_S`] around speech.
+///
+/// The encoder is trained on continuous speech. Long pauses and low-frequency rumble, as in
+/// corpora recorded sentence by sentence, put its latents where the model loses the text and
+/// repeats itself. Silence is judged in 10 ms frames against the 99th-percentile frame energy. A
+/// recording that would keep less than half a second is returned only high-passed.
+pub fn condense_speech(pcm: &[f32], sample_rate: u32) -> Vec<f32> {
+    // Second-order Butterworth high-pass (RBJ biquad, Q = 1/sqrt(2)), direct form II transposed.
+    let w0 = 2.0 * std::f64::consts::PI * SPEECH_HIGHPASS_HZ as f64 / sample_rate as f64;
+    let alpha = w0.sin() / std::f64::consts::SQRT_2;
+    let (cos, a0) = (w0.cos(), 1.0 + w0.sin() / std::f64::consts::SQRT_2);
+    let b = [(1.0 + cos) / 2.0 / a0, -(1.0 + cos) / a0, (1.0 + cos) / 2.0 / a0];
+    let a = [-2.0 * cos / a0, (1.0 - alpha) / a0];
+    let (mut z1, mut z2) = (0f64, 0f64);
+    let filtered: Vec<f32> = pcm
+        .iter()
+        .map(|&x| {
+            let x = x as f64;
+            let y = b[0] * x + z1;
+            z1 = b[1] * x - a[0] * y + z2;
+            z2 = b[2] * x - a[1] * y;
+            y as f32
+        })
+        .collect();
+
+    let frame = (sample_rate / 100) as usize;
+    let n_frames = filtered.len() / frame;
+    if n_frames == 0 {
+        return filtered;
+    }
+    let energy: Vec<f32> = filtered
+        .chunks_exact(frame)
+        .map(|f| 10.0 * (f.iter().map(|s| s * s).sum::<f32>() / frame as f32 + 1e-12).log10())
+        .collect();
+    let mut sorted = energy.clone();
+    sorted.sort_by(f32::total_cmp);
+    let loud = sorted[((n_frames - 1) as f32 * 0.99).round() as usize];
+    let margin = (SPEECH_MARGIN_S * 100.0).round() as usize;
+    let mut keep = vec![false; n_frames];
+    for (i, &e) in energy.iter().enumerate() {
+        if e > loud - SILENCE_BELOW_DB {
+            keep[i.saturating_sub(margin)..(i + margin + 1).min(n_frames)].fill(true);
+        }
+    }
+    let kept: Vec<f32> = filtered
+        .chunks_exact(frame)
+        .zip(&keep)
+        .filter(|(_, k)| **k)
+        .flat_map(|(f, _)| f.iter().copied())
+        .collect();
+    if kept.len() < sample_rate as usize / 2 { filtered } else { kept }
+}
