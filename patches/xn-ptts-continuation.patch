+/// A voice file's continuation prefix, when it has one: the end of the reference recording as
+/// codec latents (`prefix_latents`, `[T, ldim]` or `[1, T, ldim]`, in the codec's own space) and
+/// their transcript (`prefix_text` in the metadata). Returns the latents row-major with `T`, and
+/// the transcript. A voice cloned this way speaks every chunk as a continuation of the recording.
+pub fn load_voice_prefix<B: Backend>(
+    path: &std::path::Path,
+    dev: &B,
+) -> Result<Option<(Vec<f32>, usize, String)>> {
+    use xn::error::Context;
+
+    let vb = VB::load(&[path], dev.clone())?;
+    if !vb.tensor_names().contains(&PREFIX_LATENTS_TENSOR) {
+        return Ok(None);
+    }
+    let label = format!("voice file {}", path.display());
+    let header: serde_json::Value = serde_json::from_slice(&read_safetensors_header(path)?)
+        .map_err(|e| Error::invalid_data(format!("cannot parse safetensors header of {label}: {e}")))?;
+    let text = header
+        .get("__metadata__")
+        .and_then(|m| m.get(PREFIX_TEXT_KEY))
+        .and_then(|t| t.as_str())
+        .ok_or_else(|| {
+            Error::invalid_data(format!(
+                "{label} has `{PREFIX_LATENTS_TENSOR}` but no `{PREFIX_TEXT_KEY}` metadata"
+            ))
+        })?
+        .to_string();
+    let shape = vb.shape(PREFIX_LATENTS_TENSOR).context("prefix tensor not found")?;
+    let frames = match shape.dims() {
+        [t, _] | [1, t, _] => *t,
+        dims => {
+            return Err(Error::invalid_data(format!(
+                "`{PREFIX_LATENTS_TENSOR}` in {label} has shape {dims:?}, expected [T, ldim] or \
+                 [1, T, ldim]"
+            )));
+        }
+    };
+    let latents: Tensor<f32, B> = vb.tensor(PREFIX_LATENTS_TENSOR, shape)?;
+    Ok(Some((latents.to_vec()?, frames, text)))
+}
