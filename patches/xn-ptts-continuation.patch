+/// Steps the flow LM through a voice prefix's latents as if it had generated them, the first
+/// step from BOS, so the chunk continues the reference recording. Returns the last latent, the
+/// input of the first generated step.
+fn teacher_force<Q: BackendQ>(
+    model: &TTSModel<Q>,
+    prefix: &Prefix<Q>,
+    state: &mut TTSState<Q>,
+    cfg_state: &mut Option<(f32, TTSState<Q>)>,
+    rng: &mut Box<dyn crate::flow_lm::Rng + Send>,
+) -> Result<Tensor<Q::T, Q::B>> {
+    let (_, frames, _) = prefix.latents.dims3()?;
+    let mut prev: Option<Tensor<Q::T, Q::B>> = None;
+    for i in 0..frames {
+        let input = match &prev {
+            None => StepInput::Bos { batch: 1 },
+            Some(t) => StepInput::Latent(t),
+        };
+        // the sampled latent is discarded: the recording's own frame is the next input
+        match cfg_state.as_mut() {
+            Some((coef, null_state)) => {
+                model.generate_step_cfg(state, null_state, *coef, input, rng)?;
+            }
+            None => {
+                model.generate_step(state, input, rng)?;
+            }
+        }
+        prev = Some(prefix.latents.narrow(1, i..i + 1)?.contiguous()?);
+    }
+    prev.ok_or_else(|| Error::invalid_argument("voice prefix has no frames"))
+}
