+        pcm.extend(tone(sr));
+        let out = condense_speech(&pcm, sr as u32);
+        let margin = 2 * (SPEECH_MARGIN_S * sr as f32) as usize;
+        assert!(out.len() >= 2 * sr && out.len() <= 2 * sr + margin + sr / 50, "{}", out.len());
+    }
+
+    #[test]
+    fn condense_speech_keeps_silence_only_input() {
+        let out = condense_speech(&vec![0.0; 24000], 24000);
+        assert_eq!(out.len(), 24000);
+    }
+}
